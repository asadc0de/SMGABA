# Supabase Configuration
# Required for server-side writes and reads to the webinar_redirects table
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Internal Admin Password
# Required for unlocking /tools/redirections
INTERNAL_ADMIN_PASSWORD=your-secure-internal-admin-password

# noCRM.io Configuration
# Required for capturing leads from website contact and consultation forms
NOCRM_API_KEY=your-nocrm-api-key
NOCRM_SUBDOMAIN=your-nocrm-subdomain
# Optional noCRM pipeline and step configurations
NOCRM_PIPELINE=
NOCRM_STEP=

# Resend Email Configuration
# Required for sending instant email notifications for all form submissions
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM="SMG Cares <no-reply@smgaba.com>"
NOTIFY_EMAIL=smgmarketing@smgaba.com

# Chatbase Webhook Secret
# Required for authenticating Chatbase lead collection webhooks at /api/chatbase-lead
CHATBASE_WEBHOOK_SECRET=your-chatbase-webhook-secret

