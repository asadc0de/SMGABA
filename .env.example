# Supabase Configuration
# Required for server-side writes and reads to the webinar_redirects table
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Internal Admin Password
# Required for unlocking /tools/redirections
INTERNAL_ADMIN_PASSWORD=your-secure-internal-admin-password
